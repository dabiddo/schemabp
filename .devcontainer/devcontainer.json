{
	"name": "schemabpup",
	"remoteUser": "node",
  "containerUser": "node",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/sshd:1": {}
	},
	"forwardPorts": [
		3001
	],
	"customizations": {
    "zed": {
                "extensions": ["vue", "html", "emmet"]
            },
		"vscode": {
			"extensions": [
				"Nuxtr.nuxt-vscode-extentions",
				"praburangki.nuxt-snippets",
				"exer7um.vue-3-vscode-snippets",
				"Vue.volar",
				"MisterJ.vue-volar-extention-pack"
			]
		}
	}
}
